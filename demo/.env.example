# Demo configuration. Copy to demo/.env and add your Paystack TEST keys:
# https://dashboard.paystack.com/#/settings/developers  (switch the dashboard to Test Mode)

PAYSTACK_SECRET_KEY=sk_test_xxxx-replace-with-your-test-secret-key
PAYSTACK_PUBLIC_KEY=pk_test_xxxx-replace-with-your-test-public-key

# Create the Paystack customer when a wallet is created
WALLET_AUTO_CREATE_PAYSTACK_CUSTOMER=true
# Dedicated virtual accounts in test mode use the "test-bank" provider
WALLET_DEDICATED_ACCOUNT_PROVIDER=test-bank

# Fees on, so you can watch the fee engine work
WALLET_ENABLE_FEES=true
WALLET_DEPOSIT_FEE_BEARER=customer
WALLET_ENABLE_PAYMENT_FEES=true
WALLET_PAYMENT_PERCENTAGE_FEE=5
WALLET_PAYMENT_FEE_BEARER=merchant

# After checkout, the wallet callback verifies the payment and sends you back here
WALLET_CALLBACK_REDIRECT_URL=/

# Notifications are printed in the server terminal (console email backend)
WALLET_NOTIFICATION_BACKENDS=wallet.notifications.backends.EmailNotificationBackend,wallet.notifications.backends.LoggingNotificationBackend

# Try these too:
# WALLET_REQUIRE_TRANSACTION_PIN=true
# WALLET_MAXIMUM_DAILY_TRANSACTION=50000
# WALLET_ENABLE_WITHDRAWALS=false
# WALLET_THROTTLE_RATES={"lookup": "5/min", "pin": "5/min", "money": "10/min", "otp": "5/min", "resolve": "10/min"}
