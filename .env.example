# =====================================================================
# django-paystack-wallet - environment configuration
#
# Copy to `.env` and fill in. Every value can also be set in settings.py
# under the same name; settings.py wins over the environment.
# Booleans: true/false, 1/0, yes/no. Lists: comma separated or JSON.
# Leave a line commented out to use the package default shown.
# Run `python manage.py wallet_settings` to see what is actually in effect.
# =====================================================================

# ---------------------------------------------------------------------
# Paystack (required) - https://dashboard.paystack.com/#/settings/developers
# ---------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAYSTACK_API_URL=https://api.paystack.co
# PAYSTACK_TIMEOUT=30
# Retries apply to GET requests only (never to charges or transfers)
# PAYSTACK_MAX_RETRIES=2

# ---------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------
# WALLET_CURRENCY=NGN
# Country of your Paystack integration (cards from elsewhere use international pricing)
# WALLET_COUNTRY=NG
# WALLET_AUTO_CREATE_WALLET=true
# WALLET_AUTO_CREATE_PAYSTACK_CUSTOMER=true
# WALLET_USE_CELERY=false

# ---------------------------------------------------------------------
# Feature switches - turn off what you don't need
# ---------------------------------------------------------------------
# WALLET_ENABLE_DEPOSITS=true
# WALLET_ENABLE_WITHDRAWALS=true
# WALLET_ENABLE_INTERNAL_TRANSFERS=true
# WALLET_ENABLE_PAYMENTS=true
# WALLET_ENABLE_CARDS=true
# WALLET_ENABLE_CARD_REFUNDS=true
# WALLET_ENABLE_DEDICATED_ACCOUNTS=true
# WALLET_ENABLE_SETTLEMENTS=true
# WALLET_ENABLE_WEBHOOK_FORWARDING=false
# WALLET_ENABLE_RECIPIENT_LOOKUP=true
# WALLET_SAVE_CARDS=true

# ---------------------------------------------------------------------
# Dedicated virtual accounts (bank transfer funding)
# ---------------------------------------------------------------------
# WALLET_AUTO_CREATE_DEDICATED_ACCOUNT=false
# e.g. wema-bank, titan-paystack (use test-bank with test keys)
# WALLET_DEDICATED_ACCOUNT_PROVIDER=

# ---------------------------------------------------------------------
# Limits (empty/none = unlimited)
# ---------------------------------------------------------------------
# WALLET_MINIMUM_BALANCE=0
# WALLET_MINIMUM_TRANSACTION_AMOUNT=
# WALLET_MAXIMUM_TRANSACTION_AMOUNT=
# WALLET_MAXIMUM_DAILY_TRANSACTION=
# WALLET_MINIMUM_DEPOSIT_AMOUNT=50
# WALLET_MINIMUM_WITHDRAWAL_AMOUNT=100

# ---------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------
# WALLET_REQUIRE_TRANSACTION_PIN=false
# WALLET_PIN_LENGTH=4
# WALLET_PIN_MAX_ATTEMPTS=5
# WALLET_PIN_LOCKOUT_MINUTES=30
# Only accept webhooks from Paystack's IPs
# WALLET_WEBHOOK_VERIFY_IP=false
# WALLET_WEBHOOK_ALLOWED_IPS=52.31.139.75,52.49.173.169,52.214.14.220
# Only enable behind a proxy you trust (e.g. nginx, a load balancer)
# WALLET_TRUST_X_FORWARDED_FOR=false
# Rate limits per user (use a shared cache such as Redis with several servers)
# WALLET_ENABLE_THROTTLING=true
# WALLET_THROTTLE_RATES={"lookup": "20/min", "pin": "5/min", "money": "30/min", "otp": "5/min", "resolve": "20/min"}
# Retries of money-moving POSTs with the same key replay the first response
# WALLET_IDEMPOTENCY_HEADER=Idempotency-Key
# WALLET_REQUIRE_IDEMPOTENCY_KEY=false
# WALLET_IDEMPOTENCY_TTL_HOURS=24
# Logger that receives staff/user audit events (refunds, reversals, escrow, locks)
# WALLET_AUDIT_LOGGER=wallet.audit

# ---------------------------------------------------------------------
# Phone numbers & transfer recipients
# ---------------------------------------------------------------------
# Attribute on your user model holding the phone number (e.g. phone, profile.phone_number)
# WALLET_USER_PHONE_FIELD=
# WALLET_PHONE_DEFAULT_COUNTRY_CODE=234
# Dotted path to your own normaliser callable
# WALLET_PHONE_NUMBER_NORMALIZER=
# WALLET_TRANSFER_RECIPIENT_LOOKUP_FIELDS=id,tag,phone_number,email

# ---------------------------------------------------------------------
# Fees (all off until WALLET_ENABLE_FEES=true)
# ---------------------------------------------------------------------
# WALLET_ENABLE_FEES=false
# WALLET_FEE_CALCULATOR=wallet.services.fee_service.FeeCalculator
# WALLET_USE_DATABASE_FEE_CONFIG=false
# Bearers: customer | merchant | platform | split
# WALLET_DEFAULT_FEE_BEARER=platform
# WALLET_DEPOSIT_FEE_BEARER=
# WALLET_WITHDRAWAL_FEE_BEARER=customer
# WALLET_TRANSFER_FEE_BEARER=
# WALLET_PAYMENT_FEE_BEARER=
# WALLET_DVA_FEE_BEARER=merchant
# WALLET_ALLOW_FEE_BEARER_OVERRIDE=false
# WALLET_DEPOSIT_FEE_GROSS_UP=true
# WALLET_ENABLE_DEPOSIT_FEES=true

# Local cards / bank / USSD / QR
# WALLET_LOCAL_CARD_PERCENTAGE_FEE=1.5
# WALLET_LOCAL_CARD_FLAT_FEE=100
# WALLET_LOCAL_CARD_FEE_CAP=2000
# WALLET_LOCAL_CARD_FEE_WAIVER_THRESHOLD=2500
# International cards
# WALLET_INTL_CARD_PERCENTAGE_FEE=3.9
# WALLET_INTL_CARD_FLAT_FEE=100
# WALLET_INTL_CARD_FEE_CAP=
# Dedicated virtual accounts / bank transfer
# WALLET_DVA_PERCENTAGE_FEE=1.0
# WALLET_DVA_FLAT_FEE=0
# WALLET_DVA_FEE_CAP=300
# Mobile money
# WALLET_MOBILE_MONEY_PERCENTAGE_FEE=1.95
# WALLET_MOBILE_MONEY_FLAT_FEE=0
# WALLET_MOBILE_MONEY_FEE_CAP=
# Withdrawals to bank
# WALLET_ENABLE_TRANSFER_FEES=true
# WALLET_TRANSFER_FEE_TIERS=[{"max_amount": 5000, "fee": 10}, {"max_amount": 50000, "fee": 25}, {"max_amount": null, "fee": 50}]
# Wallet-to-wallet transfers
# WALLET_ENABLE_INTERNAL_TRANSFER_FEES=false
# WALLET_INTERNAL_TRANSFER_PERCENTAGE_FEE=0
# WALLET_INTERNAL_TRANSFER_FLAT_FEE=0
# WALLET_INTERNAL_TRANSFER_FEE_CAP=
# Wallet payments / marketplace commission
# WALLET_ENABLE_PAYMENT_FEES=false
# WALLET_PAYMENT_PERCENTAGE_FEE=0
# WALLET_PAYMENT_FLAT_FEE=0
# WALLET_PAYMENT_FEE_CAP=
# Split bearer ratio (must add up to 100)
# WALLET_FEE_SPLIT_CUSTOMER_PERCENTAGE=50
# WALLET_FEE_SPLIT_MERCHANT_PERCENTAGE=50
# Educational institutions
# WALLET_ENABLE_EDUCATIONAL_PRICING=false
# WALLET_EDUCATIONAL_CARD_PERCENTAGE_FEE=0.7
# WALLET_EDUCATIONAL_CARD_FEE_CAP=1500

# ---------------------------------------------------------------------
# Settlements (payouts)
# ---------------------------------------------------------------------
# WALLET_AUTO_SETTLEMENT=false

# ---------------------------------------------------------------------
# Notifications (nothing is sent unless you list backends)
# ---------------------------------------------------------------------
# WALLET_NOTIFICATION_BACKENDS=wallet.notifications.backends.EmailNotificationBackend
# WALLET_EMAIL_SENDER=wallet@yourdomain.com

# ---------------------------------------------------------------------
# Checkout
# ---------------------------------------------------------------------
# e.g. https://api.yourdomain.com/wallet/callback/
# WALLET_DEFAULT_CALLBACK_URL=
# e.g. https://app.yourdomain.com/wallet/funded (gets ?reference=...&status=...)
# WALLET_CALLBACK_REDIRECT_URL=
# WALLET_PAYMENT_CHANNELS=card,bank,ussd,qr,mobile_money,bank_transfer
# WALLET_RECONCILE_AFTER_MINUTES=10
# WALLET_RECONCILE_BATCH_SIZE=500

# ---------------------------------------------------------------------
# Data retention (manage.py prune_wallet_data). Ledger data is never pruned.
# ---------------------------------------------------------------------
# WALLET_WEBHOOK_RETENTION_DAYS=90
# WALLET_WEBHOOK_RETRY_WINDOW_HOURS=72

# ---------------------------------------------------------------------
# REST API
# ---------------------------------------------------------------------
# WALLET_API_PERMISSION_CLASSES=rest_framework.permissions.IsAuthenticated
# WALLET_API_PAGE_SIZE=20
# WALLET_API_MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------
# Banks & exports
# ---------------------------------------------------------------------
# WALLET_AUTO_SYNC_BANKS=false
# WALLET_BANK_COUNTRY=nigeria
# WALLET_EXPORT_PAGESIZE=A4
# WALLET_EXPORT_ORIENTATION=portrait
